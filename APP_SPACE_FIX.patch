+
+def _sanitize_external_payload(value):
+    """Remove explicit external attempts to write identity-like claims from context."""
+    if isinstance(value, dict):
+        lowered = {str(k).lower() for k in value}
+        has_identity_claim = bool(lowered & _IDENTITY_CLAIM_KEYS)
+        cleaned = {}
+        for key, item in value.items():
+            if str(key).lower() in _IDENTITY_CLAIM_KEYS:
+                continue
+            if has_identity_claim and str(key).lower() in {"value", "content"}:
+                continue
+            cleaned[key] = _sanitize_external_payload(item)
+        if has_identity_claim:
+            cleaned["untrusted_identity_claim_removed"] = True
+        return cleaned
+    if isinstance(value, list):
+        return [_sanitize_external_payload(v) for v in value]
+    if isinstance(value, tuple):
+        return tuple(_sanitize_external_payload(v) for v in value)
+    return value
 
 
